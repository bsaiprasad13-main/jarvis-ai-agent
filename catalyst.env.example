# Copy to catalyst.env (gitignored) and fill in. scripts/deploy_catalyst.py sends these to the
# Catalyst function on every deploy, so nothing typed in the console gets wiped.
GEMINI_API_KEY=
PRODUCT_HUNT_DEVELOPER_TOKEN=
JARVIS_BUCKET=jarvis-reports-66495

# Alert emails (Resend). The from-address must use your Resend-verified domain.
RESEND_API_KEY=
ALERT_TO_EMAIL=
ALERT_FROM_EMAIL=Jarvis <jarvis@your-verified-domain>
