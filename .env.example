# For running Jarvis on your own machine: copy to .env and fill in.
# (For Zoho Catalyst, use catalyst.env instead; see catalyst.env.example.)

# Gemini: writes, checks and backs up (one key covers all the Gemini models used)
GEMINI_API_KEY=

# Product Hunt developer token: new tools for the Global desk
PRODUCT_HUNT_DEVELOPER_TOKEN=

# Optional: alert emails through Resend when a run fails or needs the backup pipeline.
# Without these, alerts are printed instead of emailed.
RESEND_API_KEY=
ALERT_TO_EMAIL=
ALERT_FROM_EMAIL=Jarvis <jarvis@your-verified-domain>
